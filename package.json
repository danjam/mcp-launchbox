{
  "name": "mcp-launchbox",
  "version": "1.0.0",
  "description": "An MCP server for querying your LaunchBox game library.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "test": "npm run build && node --test 'test/**/*.test.js'",
    "test:only": "node --test 'test/**/*.test.js'"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.6",
    "fuse.js": "^7.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/node": "^25.3.0",
    "typescript": "^5.9.3"
  }
}
